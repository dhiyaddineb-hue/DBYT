# DBYT configuration — copy to `.env` and fill in what you need.
# Never commit the real `.env` file or any cookies/API keys.

# ---- Workspace (single folder; everything produced goes here) ----
# DBYT_WORKSPACE_DIR=/app/workspace
# DBYT_DATA_DIR=/app/workspace/data
# DBYT_JOBS_DIR=/app/workspace/jobs
# DBYT_UPLOADS_DIR=/app/workspace/uploads
# DBYT_OUTPUT_DIR=/app/workspace/output
# DBYT_MODELS_DIR=/app/workspace/models

# ---- Server, domain, and public API security ----
DBYT_HOST=0.0.0.0
DBYT_PORT=8000
# Used by deploy/docker-compose.prod.yml and deploy/Caddyfile.
# DBYT_DOMAIN=your-domain.example
# TLS_EMAIL=admin@your-domain.example
# Required for a public deployment. Send it as X-API-Key or Authorization: Bearer <key>.
# DBYT_API_KEY=generate-a-long-random-secret
# Set this to the exact frontend origin(s), comma-separated; avoid * in production.
# DBYT_CORS_ORIGINS=https://your-domain.example

# ---- Dubbing precision ----
# DBYT_GRANULARITY=word      # word | segment (word = every word in its place)
# DBYT_LIP_SYNC=false        # true = re-animate the mouth (Wav2Lip, needs GPU)

# ---- Repository-as-workspace ----
# Keep false on a hosted server unless a dedicated deploy key and single-writer
# policy are configured. Concurrent jobs must not push to the same branch.
DBYT_AUTO_COMMIT=false

# ---- Downloader routes ----
# Direct yt-dlp is the default. Set to true only when you intentionally accept
# the browser downloader pool and its third-party sites.
DBYT_COBALT_BROWSER=false
# DBYT_CHROME_BINARY=/usr/bin/google-chrome
# DBYT_DOWNLOADER_SITES=name|https://trusted.example,other|https://trusted.example
# DBYT_YOUTUBE_COOKIES=/run/secrets/youtube-cookies.txt
# DBYT_YOUTUBE_PROXIES=socks5h://USER:PASSWORD@HOST:PORT
# DBYT_COBALT_URL=https://authorized-cobalt.example
# DBYT_COBALT_API_KEY=authorized-api-key
# DBYT_INVIDIOUS_INSTANCES=https://trusted-invidious.example

# ---- Whisper transcription model (tiny/base/small/medium/large-v3) ----
DBYT_WHISPER_MODEL=small
DBYT_WHISPER_DEVICE=auto
DBYT_WHISPER_COMPUTE_TYPE=auto

# ---- Translation ----
DBYT_DEFAULT_TARGET_LANG=ar
# DBYT_TRANSLATOR_BACKEND=google   # google | openai | argos (offline) | nllb (offline)

# ---- Optional premium voices / translation ----
# DBYT_OPENAI_API_KEY=sk-...
# DBYT_ELEVENLABS_API_KEY=your-key
# DBYT_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- Mixing ----
# DBYT_KEEP_BACKGROUND=true
# DBYT_BACKGROUND_DUCK_VOLUME=0.18
