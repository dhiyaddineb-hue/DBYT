# =====================================================================
# DBYT — the repository IS the workspace.
#
# Produced files (models, uploads, jobs, output) live in `workspace/` and
# are tracked when they are part of a dubbing job (via Git LFS where applicable).
# Ephemeral offline-demo media is excluded by the rules at the end of this file.
# =====================================================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets — never commit real keys
.env
.env.*
!.env.example
config.local.json
secrets/
*.pem

# Vendored third-party repos (cloned at runtime, not committed)
third_party/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.log
nohup.out

# Node
node_modules/
.next/
dist/
build/

# Offline demo media is generated on demand and should not be committed.
workspace/demo/*
!workspace/demo/.gitkeep
workspace/output/samples/*
!workspace/output/samples/.gitkeep
